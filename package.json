{
  "name": "next-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint --force",
    "format": "oxfmt --config ./.oxfmtrc.json --ignore-path ./.oxfmtignore --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:push": "pnpm --filter @workspace/database db:push",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "env:check": "node --experimental-strip-types scripts/env-check.ts",
    "dedupe:check": "pnpm dedupe --check",
    "admin:bootstrap": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "format:check": "oxfmt --config ./.oxfmtrc.json --ignore-path ./.oxfmtignore --check ."
  },
  "dependencies": {
    "@tanstack/react-form": "catalog:"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:",
    "@changesets/cli": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.0.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  }
}
